# Hosting cPanel (Apache/LiteSpeed): arahkan semua alamat halaman ke index.html (React Router),
# kecuali file/folder yang benar-benar ada (gambar, video, /admin).
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^admin/?$ /admin/index.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# File JS/CSS hasil build bernama unik (mis. index-BDtgDD4O.js), aman disimpan lama di browser pengunjung.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
